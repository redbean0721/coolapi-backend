API_TITLE=FastAPI
API_VERSION=1.0.0
API_URL="https://api.example.com"
MARIADB_URL="mysql+asyncmy://fastapi:password@localhost:3306/fastapi"
REDIS_URL="redis://default:password@localhost:6379/0"
# 10/sec -> 10/sec
# 300/min -> 5/sec
# 7200/hour -> 2/sec
# 28800/day -> 0.33/sec
SMTP_SERVER="mx1.example.com"
SMTP_PORT=587
EMAIL_SENDER="no-reply@example.com"
EMAIL_REPLY_TO="support@example.com"
EMAIL_PASSWORD="password"

COOKIE_NAME="auth"
COOKIE_HTTPONLY=True    # JS 無法讀
COOKIE_MAX_AGE=259200   # 3 days in seconds
COOKIE_PATH="/"         # Cookie 適用路徑
COOKIE_SAMESITE="lax"   # CSRF 防護, lax: 同站請求攜帶 cookie, 跨站部分請求攜帶 cookie; strict: 完全不攜帶; none: 全部攜帶
COOKIE_SECURE=True     # 僅 HTTPS 傳輸
COOKIE_DOMAIN="api.example.com" # Cookie 適用網域